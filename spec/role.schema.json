{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sortyard.ai/spec/role.schema.json",
  "title": "Role",
  "description": "Role / Persona: who is asking at a stage (§3.4). Template roles planner, implementer, reviewer, designer (infrastructure omits designer), plus agentic-persona C-suite personas. A role = system-prompt bundle + context allowlist policy + tool permissions + default model policy. 'operator' is not a role.",
  "x-sortyard-design-ref": "§3.4",
  "x-sortyard-store": "definition",
  "type": "object",
  "allOf": [{"$ref": "common.schema.json#/$defs/definition_base"}],
  "required": ["kind", "name", "system_prompt_bundle", "context_allowlist", "tool_permissions", "default_model_policy"],
  "properties": {
    "kind": {"enum": ["role", "persona"]},
    "name": {"type": "string", "minLength": 1, "not": {"const": "operator"}},
    "system_prompt_bundle": {"description": "Path or content ref of the prompt bundle.", "type": "string", "minLength": 1},
    "context_allowlist": {"type": "array", "items": {"type": "string"}},
    "tool_permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "default_model_policy": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": {"type": "string"},
        "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "require_frontier": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false,
  "examples": [{
    "id": "role-implementer", "workspace_id": "ws-noncelogic", "version": "1.0.0",
    "kind": "role", "name": "implementer", "system_prompt_bundle": "roles/implementer/",
    "context_allowlist": ["task", "design_ref", "repo"], "tool_permissions": ["shell", "edit"],
    "default_model_policy": {"model": "claude-opus-5-5", "effort": "high"}
  }]
}
