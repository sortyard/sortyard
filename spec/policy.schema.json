{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sortyard.ai/spec/policy.schema.json",
  "title": "Policy",
  "description": "Every enforceable rule as an object (§3.6): id, scope, kind, parameters, enforcement (refuse | warn | record), absent-state behaviour, version, audit history. Conductor and workers read policy at decision time. Parameters are checked per kind; kinds whose parameters the draft does not specify stay open (see NOTES.md).",
  "x-sortyard-design-ref": "§3.6",
  "x-sortyard-store": "definition",
  "type": "object",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/definition_base"},
    {"if": {"properties": {"scope": {"not": {"const": "global"}}}, "required": ["scope"]},
     "then": {"required": ["scope_ref"]}},
    {"if": {"properties": {"kind": {"const": "merge_gate"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/merge_gate"}}}},
    {"if": {"properties": {"kind": {"const": "pipeline_purity"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/pipeline_purity"}}}},
    {"if": {"properties": {"kind": {"const": "replica_required"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/replica_required"}}}},
    {"if": {"properties": {"kind": {"const": "secrets"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/secrets"}}}},
    {"if": {"properties": {"kind": {"const": "model_budget"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/model_budget"}}}},
    {"if": {"properties": {"kind": {"const": "credential_pool"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/credential_pool"}}}},
    {"if": {"properties": {"kind": {"const": "retention"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/retention"}}}},
    {"if": {"properties": {"kind": {"const": "runner"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/runner"}}}},
    {"if": {"properties": {"kind": {"const": "handback"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/handback"}}}},
    {"if": {"properties": {"kind": {"const": "stall"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/stall"}}}},
    {"if": {"properties": {"kind": {"const": "escalation"}}, "required": ["kind"]},
     "then": {"properties": {"parameters": {"$ref": "#/$defs/escalation"}}}}
  ],
  "required": ["scope", "kind", "parameters", "enforcement", "absent_state"],
  "properties": {
    "name": {"type": "string"},
    "scope": {"$ref": "common.schema.json#/$defs/scope"},
    "scope_ref": {"description": "Project, workflow or stage the policy applies to when scope is not global.", "type": "string", "minLength": 1},
    "kind": {
      "enum": ["merge_gate", "pipeline_purity", "replica_required", "secrets", "model_budget",
               "credential_pool", "retention", "runner", "handback", "stall", "escalation"]
    },
    "parameters": {"type": "object"},
    "enforcement": {"enum": ["refuse", "warn", "record"]},
    "absent_state": {"$ref": "common.schema.json#/$defs/absent_state"},
    "audit_history": {
      "description": "AuditLog entry ids for every change to this policy.",
      "type": "array", "items": {"$ref": "common.schema.json#/$defs/ref"}
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "merge_gate": {
      "description": "Red never merges; absent checks are a coverage gap (record + file ticket + merge on review/local proof); no force-merge ever. Review count is scoped by regime.",
      "type": "object",
      "required": ["regime", "review_count"],
      "properties": {
        "regime": {"enum": ["conductor_product_pr", "design_record", "mh_design_chain"]},
        "review_count": {"type": "integer", "minimum": 1},
        "review_dimensions": {"type": "array", "items": {"enum": ["correctness", "usability"]}, "uniqueItems": true},
        "separate_sessions": {"type": "boolean"},
        "fix_rounds": {"description": "Post-#199 fix-round count: UNVERIFIED in the draft (§10). No default is frozen.", "type": "integer", "minimum": 0},
        "red_never_merges": {"const": true, "default": true},
        "absent_checks": {"const": "coverage_gap", "default": "coverage_gap"},
        "force_merge": {"const": false, "default": false}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"regime": {"const": "conductor_product_pr"}}},
         "then": {"properties": {"review_count": {"const": 1}}}},
        {"if": {"properties": {"regime": {"const": "design_record"}}},
         "then": {"properties": {"review_count": {"const": 2}}}},
        {"if": {"properties": {"regime": {"const": "mh_design_chain"}}},
         "then": {"properties": {"review_count": {"const": 2}, "separate_sessions": {"const": true}}}}
      ]
    },
    "pipeline_purity": {
      "description": "No delivery-pipeline stage may declare a third-party or deployment-environment dependency; the workflow validator refuses such a workflow.",
      "type": "object",
      "properties": {
        "forbidden_dependency_kinds": {
          "type": "array", "items": {"enum": ["third_party", "deployment_environment"]}, "uniqueItems": true,
          "default": ["third_party", "deployment_environment"]
        }
      },
      "additionalProperties": false
    },
    "replica_required": {
      "description": "Build stages must attach replica adversary-review evidence before push.",
      "type": "object",
      "required": ["stages"],
      "properties": {
        "stages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidence": {"const": "replica_adversary_review", "default": "replica_adversary_review"},
        "before": {"const": "push", "default": "push"}
      },
      "additionalProperties": false
    },
    "secrets": {
      "description": "Secrets only via the secrets store, only into jobs that declare the need, never logged, never in definitions. CredentialCustody records the deliberate exceptions.",
      "type": "object",
      "properties": {
        "only_via_store": {"const": true, "default": true},
        "only_into_declaring_jobs": {"const": true, "default": true},
        "never_logged": {"const": true, "default": true},
        "never_in_definitions": {"const": true, "default": true}
      },
      "additionalProperties": false
    },
    "model_budget": {
      "description": "Per-key budgets (budgets live per API key, not in the product) and model/effort selection per stage.",
      "type": "object",
      "properties": {
        "budgets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key_ref", "limit"],
            "properties": {
              "key_ref": {"$ref": "common.schema.json#/$defs/secret_ref"},
              "limit": {"type": "number", "minimum": 0},
              "unit": {"enum": ["usd", "tokens"]},
              "window_seconds": {"$ref": "common.schema.json#/$defs/duration_seconds"}
            },
            "additionalProperties": false
          }
        },
        "stage_models": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "model": {"type": "string"},
              "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
              "require_frontier": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "credential_pool": {
      "description": "Subscription accounts as pooled resources: selection + failure isolation. Not a lease and not a concurrency limiter.",
      "type": "object",
      "properties": {
        "picker": {"const": "least_burned", "default": "least_burned"},
        "burn_window_seconds": {"type": "integer", "minimum": 0, "default": 18000},
        "cooldown_on_limit_seconds": {"type": "integer", "minimum": 0, "default": 18000},
        "max_requeues": {"type": "integer", "minimum": 0, "default": 3},
        "members": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ref"}}
      },
      "additionalProperties": false
    },
    "retention": {
      "description": "Draft names the kind only; parameters are open (NOTES.md).",
      "type": "object",
      "properties": {
        "subject": {"type": "string"},
        "keep_days": {"type": "integer", "minimum": 0}
      }
    },
    "runner": {
      "description": "No GitHub-hosted runners — estate/self-hosted only; Dependabot is the sole exception.",
      "type": "object",
      "properties": {
        "allow_github_hosted": {"const": false, "default": false},
        "exceptions": {"type": "array", "items": {"const": "dependabot"}, "default": ["dependabot"]}
      },
      "additionalProperties": false
    },
    "handback": {
      "description": "Draft names the kind; the mandatory reason/evidence and 24h re-alert come from §3.3/§3.8. Open otherwise (NOTES.md).",
      "type": "object",
      "properties": {
        "require_reason": {"const": true, "default": true},
        "require_evidence": {"type": "boolean", "default": true},
        "realert_dwell_seconds": {"type": "integer", "minimum": 0, "default": 86400}
      }
    },
    "stall": {
      "description": "Stall detection; values from the mh-chain rules in §3.3. Open otherwise (NOTES.md).",
      "type": "object",
      "properties": {
        "revision_round_cap": {"type": "integer", "minimum": 0, "default": 4},
        "infrastructure_failures_before_stall": {"type": "integer", "minimum": 1, "default": 2}
      }
    },
    "escalation": {
      "description": "Self-repair limits from §3.3. Open otherwise (NOTES.md).",
      "type": "object",
      "properties": {
        "max_repair_attempts_per_defect": {"type": "integer", "minimum": 0, "default": 2},
        "not_dispatcher_side_attempts": {"type": "integer", "minimum": 0, "default": 1},
        "repaired_code_running_deadline_seconds": {"type": "integer", "minimum": 0, "default": 900}
      }
    }
  },
  "examples": [{
    "id": "pol-merge-conductor", "workspace_id": "ws-noncelogic", "version": "1.0.0", "source": "git",
    "scope": "global", "kind": "merge_gate",
    "parameters": {"regime": "conductor_product_pr", "review_count": 1, "red_never_merges": true, "force_merge": false},
    "enforcement": "refuse", "absent_state": {"behaviour": "record", "reason_code": "coverage_gap"}
  }, {
    "id": "pol-grooming-frontier", "workspace_id": "ws-noncelogic", "version": "1.0.0",
    "scope": "workflow", "scope_ref": "wf-grooming", "kind": "model_budget",
    "parameters": {"stage_models": {"groom": {"model": "claude-opus-5-5", "require_frontier": true}}},
    "enforcement": "refuse", "absent_state": {"behaviour": "refuse", "reason_code": "non_frontier_model"}
  }, {
    "id": "pol-pool", "workspace_id": "ws-noncelogic", "version": "1.0.0", "scope": "global", "kind": "credential_pool",
    "parameters": {"picker": "least_burned", "burn_window_seconds": 18000, "cooldown_on_limit_seconds": 18000, "max_requeues": 3},
    "enforcement": "refuse", "absent_state": {"behaviour": "refuse", "reason_code": "credential_pool_empty"}
  }]
}
