{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sortyard.ai/spec/secret.schema.json",
  "title": "Secret",
  "description": "A reference, never a value (§3.7a). Points at the secrets store (OpenBao for NonceLogic; external-secrets, sealed-secrets or plain Kubernetes Secrets for OSS installs). The Admin console manages references, scopes and rotation state; values never transit the harness API, so this schema admits no value field.",
  "x-sortyard-design-ref": "§3.7a",
  "x-sortyard-store": "config",
  "type": "object",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/object_base"},
    {"not": {"anyOf": [{"required": ["value"]}, {"required": ["data"]}, {"required": ["plaintext"]}]}}
  ],
  "required": ["name", "backend", "locator", "scope"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "backend": {"enum": ["openbao", "external-secrets", "sealed-secrets", "kubernetes-secret"]},
    "locator": {"description": "Path/key in the backend, e.g. kv/sortyard/github-app.", "type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["global", "project", "integration", "job"]},
        "ref": {"$ref": "common.schema.json#/$defs/ref"}
      },
      "additionalProperties": false
    },
    "rotation": {
      "type": "object",
      "properties": {
        "state": {"enum": ["current", "due", "overdue", "rotating"]},
        "last_rotated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "next_rotation_at": {"$ref": "common.schema.json#/$defs/timestamp"}
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false,
  "examples": [{
    "id": "sec-oidc-client", "workspace_id": "ws-noncelogic", "name": "OIDC client secret",
    "backend": "openbao", "locator": "kv/sortyard/oidc", "scope": {"kind": "global"},
    "rotation": {"state": "current", "last_rotated_at": "2026-11-01T00:00:00Z"}
  }]
}
