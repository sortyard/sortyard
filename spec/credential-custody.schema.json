{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sortyard.ai/spec/credential-custody.schema.json",
  "title": "CredentialCustody",
  "description": "Per-credential custody class (§3.7a): store (secrets store), cli-owned-files (0600 files on a dedicated volume, because the CLIs own the refresh lifecycle and write tokens back), or operator-side (outside the cluster). Moving a long-lived GitHub write credential into the cluster requires explicit approval and is never assumed.",
  "x-sortyard-design-ref": "§3.7a",
  "x-sortyard-store": "config",
  "type": "object",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/object_base"},
    {"if": {"properties": {"custody": {"const": "store"}}, "required": ["custody"]},
     "then": {"required": ["secret_ref"]}},
    {"if": {"properties": {"custody": {"const": "cli-owned-files"}}, "required": ["custody"]},
     "then": {"required": ["volume", "file_mode"]}},
    {"if": {"properties": {"purpose": {"const": "github_write"}, "custody": {"not": {"const": "operator-side"}}}, "required": ["purpose", "custody"]},
     "then": {"required": ["approval_decision_id"]}}
  ],
  "required": ["credential", "purpose", "custody"],
  "properties": {
    "credential": {"description": "Human name of the credential.", "type": "string", "minLength": 1},
    "purpose": {"enum": ["github_write", "github_read", "subscription_claude", "subscription_codex", "api_key", "integration", "other"]},
    "custody": {"enum": ["store", "cli-owned-files", "operator-side"]},
    "secret_ref": {"$ref": "common.schema.json#/$defs/secret_ref"},
    "volume": {"type": "string"},
    "file_mode": {"const": "0600"},
    "operator_location": {"type": "string"},
    "grant_flow": {"enum": ["codex_device_flow", "claude_setup_token", "github_app_install", "manual"]},
    "credential_pool_ref": {"$ref": "common.schema.json#/$defs/ref"},
    "approval_decision_id": {"description": "Decision approving an in-cluster GitHub write credential.", "$ref": "common.schema.json#/$defs/ref"}
  },
  "unevaluatedProperties": false,
  "examples": [{
    "id": "cust-github-write", "workspace_id": "ws-noncelogic", "credential": "GitHub connector",
    "purpose": "github_write", "custody": "operator-side", "operator_location": "agent-side connector"
  }, {
    "id": "cust-claude-1", "workspace_id": "ws-noncelogic", "credential": "claude subscription 1",
    "purpose": "subscription_claude", "custody": "cli-owned-files", "volume": "auth-broker",
    "file_mode": "0600", "grant_flow": "claude_setup_token", "credential_pool_ref": "pool-claude"
  }]
}
